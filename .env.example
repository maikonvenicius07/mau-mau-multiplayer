# MAU-MAU CANDEIAS — exemplo de variáveis de ambiente
# Nunca publique secrets ou credenciais reais no GitHub.

# PostgreSQL — ranking, identidades e snapshots das salas
DATABASE_URL=
ROOM_SNAPSHOT_TTL_MS=28800000

# Login Google
GOOGLE_CLIENT_ID=

# Recuperação de senha por e-mail — Resend
RESEND_API_KEY=
EMAIL_FROM=MAU-MAU CANDEIAS <noreply@maumaucandeias.com.br>

# Sessão do jogo. Deve ser uma chave longa e estável.
AUTH_SESSION_SECRET=

# WebRTC / TURN opcional, recomendado para redes móveis/NAT/CGNAT
VOICE_TURN_URLS=
VOICE_TURN_USERNAME=
VOICE_TURN_CREDENTIAL=
VOICE_TURN_SECRET=
VOICE_TURN_TTL_SECONDS=3600

# Segurança/monitoramento
MAUMAU_ALLOWED_ORIGINS=
MAUMAU_HTTP_LOGS=0
MAUMAU_CONNECTION_DEBUG=0
MAUMAU_TURN_DEBUG=0
MAUMAU_REQUIRE_DATABASE=

# Limites preventivos
MAX_ROOMS=10
MAX_SPECTATORS_PER_ROOM=5

# V50.1 - cameras opcionais gratuitas com LiveKit Cloud (somente transmissão ao vivo)
# Em branco: a camera permanece desativada. NAO SALVAR CHAVES NO GITHUB.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# V51.1 — torneio experimental, sem alterar partidas nem ranking.
# Inscrições fechadas por padrão. Para abrir, use 1 no Render.
MAUMAU_TOURNAMENT_OPEN=0
MAUMAU_TOURNAMENT_ID=copa-candeias-1
MAUMAU_TOURNAMENT_NAME=Copa MAU-MAU CANDEIAS
MAUMAU_TOURNAMENT_CAPACITY=20
# ISO 8601, exemplo: 2026-11-21T19:00:00-04:00
MAUMAU_TOURNAMENT_START_AT=

# V51.2 — contas autorizadas a criar/administrar torneios.
# Recomenda-se uma conta de e-mail já cadastrada e autenticada no jogo.
# Separe múltiplos administradores por vírgulas. Em branco: ninguém administra.
MAUMAU_TOURNAMENT_ADMIN_EMAILS=
# Alternativa: identidades permanentes (playerKey) separadas por vírgula.
MAUMAU_TOURNAMENT_ADMIN_KEYS=
# As variáveis MAUMAU_TOURNAMENT_* da V51.1 servem só para cadastrar o primeiro torneio;
# após a primeira instalação, gerencie abertura, data e vagas diretamente no jogo.
