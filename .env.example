# MAU-MAU CANDEIAS — exemplo de variáveis de ambiente
# Copie somente os valores necessários para o ambiente real.
# Nunca publique senhas, secrets ou credenciais reais no GitHub.

# PostgreSQL — ranking e snapshots das salas
DATABASE_URL=
# Tempo máximo de retenção de um snapshot de sala: 8 horas
ROOM_SNAPSHOT_TTL_MS=28800000

# Login Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Deve ser uma chave fixa no Render. Se mudar, as sessões existentes são encerradas.
AUTH_SESSION_SECRET=

# WebRTC / TURN opcional, recomendado para redes móveis/NAT/CGNAT
# Exemplo de URL: turn:turn.seudominio.com:3478 ou turns:turn.seudominio.com:5349
VOICE_TURN_URLS=

# OPÇÃO A — credenciais TURN estáticas
VOICE_TURN_USERNAME=
VOICE_TURN_CREDENTIAL=

# OPÇÃO B — credenciais temporárias TURN REST/coturn (recomendado quando suportado)
# Se VOICE_TURN_SECRET estiver preenchido, ele tem prioridade sobre usuário/senha estáticos.
VOICE_TURN_SECRET=
VOICE_TURN_TTL_SECONDS=3600

# V40.58 — segurança e monitoramento
# Deixe vazio no uso normal quando frontend e servidor usam a mesma origem.
# Para mais de uma origem externa legítima, separe por vírgula.
# Ex.: https://jogo.exemplo.com,https://admin.exemplo.com
MAUMAU_ALLOWED_ORIGINS=

# Logs HTTP estruturados sem corpo, cookies, cartas ou credenciais. 1=ativado; 0=desativado.
MAUMAU_HTTP_LOGS=0

# Diagnóstico opcional de conexão/TURN. Ative somente durante investigação técnica.
MAUMAU_CONNECTION_DEBUG=0
MAUMAU_TURN_DEBUG=0
